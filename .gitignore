# --- Track only lightweight evidence under results/ (logs / CSVs / *_history pickles) ---
# Heavy artifacts (checkpoints, plots, animations, papers) stay untracked.
results/**/*.pt
results/**/*.png
results/**/*.gif
results/**/*.pdf
*.pid
# Reference media under data/ is not tracked (keep .mat / .py only)
data/**/*.png
data/**/*.gif

# Local scratch / GPU-pull mirrors / temp
/remote_gpu_pull/
/tmp/

# Superseded by final_report/, and agent tooling (mirrors ignored CLAUDE.md)
/report/
/AGENT.md

# Extra human-obstacle reference data — large; regenerate via the gen_*.py generators
data/reference/unsteady_reference_human_rot90left.mat
data/reference/unsteady_reference_human_rot90left_re100.mat

# Stray local artifacts
/Screenshot*.png
